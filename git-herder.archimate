  <folder name="Other" id="id-20d77cf4697a439b80cff2828dde297b" type="other">
    <element xsi:type="archimate:Junction" name="Создаёт соответствующую upstream'у и требуемым действиям реализацию *Builder'а" id="id-5f4ccda6f7464427891535989b158d5d"/>
    <element xsi:type="archimate:Grouping" name="Компоненты приложения" id="id-7aa2590574bd449d888b6b254dc0630e">
      <documentation>Группа, обозначающая все любые компоненты приложения Git Herder</documentation>
    </element>
