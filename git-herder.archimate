    <element xsi:type="archimate:ServingRelationship" name="Выполнение REST-запросов" id="id-0deb1b2a685c49ff96d0007d30e7881f" source="id-f46e8ffd38964f8d8c597461af0c9987" target="id-bcedaee54c2b42a9ae07da89c0ba11bd">
      <documentation>Выполнение REST-запросов</documentation>
    </element>
    <element xsi:type="archimate:ServingRelationship" id="id-caba4c0b93804dac96997e49e66e5173" source="id-e46eecf780ba4ab78bc3de0d598f0bea" target="id-bcedaee54c2b42a9ae07da89c0ba11bd"/>
