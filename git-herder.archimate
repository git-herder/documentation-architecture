    <element xsi:type="archimate:AggregationRelationship" id="id-0e2efe74a7a940d9818a0e6b3463a9f2" source="id-6b8d93faeeb64568a4524f98cd035659" target="id-41f27528f4d347618e55fc12219e0423"/>
    <element xsi:type="archimate:ServingRelationship" name="Выполнение REST-запросов" id="id-06eb03d92710404bba6542f922dae931" source="id-41f27528f4d347618e55fc12219e0423" target="id-336911d9ca73438f806f02eae9bb07d4">
